{
  "codec": "IQ-CMD.js",
  "codecVersion": "1.0.0",
  "uplinkCommon": {
    "codecVersion": "1.0.0",
    "genericModel": "IQ CMD",
    "manufacturer": "YOBIIQ B.V."
  },
  "uplinks": [
    {
      "name": "join uplink (fPort 50)",
      "fPort": 50,
      "payload": "FF6A 0100 FF69 0102 FF68 00BC614E FF9F 02 FF6B 01 FF6C 00 FF67 0B434D442D4C2D30442D3449",
      "payloadHex": "FF6A0100FF690102FF6800BC614EFF9F02FF6B01FF6C00FF670B434D442D4C2D30442D3449",
      "expected": {
        "data": {
          "hardwareVersion": "v1.0",
          "firmwareVersion": "v1.2",
          "deviceSerialNumber": "00BC614E",
          "deviceClass": "CLASS_C",
          "externalPowerStatus": "MAINS_POWER",
          "batteryVoltage": 0,
          "deviceModel": "CMD-L-0D-4I"
        }
      }
    },
    {
      "name": "read response: two digit minor versions",
      "fPort": 100,
      "payload": "FF69 010A FF6A 020F",
      "payloadHex": "FF69010AFF6A020F",
      "expected": {
        "data": {
          "firmwareVersion": "v1.10",
          "hardwareVersion": "v2.15"
        }
      }
    },
    {
      "name": "read response: device manufacturer is kept",
      "fPort": 100,
      "payload": "FF65 06594F42494951 FF66 0441434D45",
      "payloadHex": "FF6506594F42494951FF660441434D45",
      "expected": {
        "data": {
          "manufacturer": "YOBIIQ",
          "originalEquipmentManufacturer": "ACME"
        }
      }
    },
    {
      "name": "read response: LoRaWAN settings",
      "fPort": 100,
      "payload": "FF9F 02 FFA0 01 FFA1 05 FFA3 02 FFA4 0A FFA5 05A0 FFA6 01 FFA7 00 FF96 01 FF9D 32 FF9E 01",
      "payloadHex": "FF9F02FFA001FFA105FFA302FFA40AFFA505A0FFA601FFA700FF9601FF9D32FF9E01",
      "expected": {
        "data": {
          "deviceClass": "CLASS_C",
          "adr": "ENABLED",
          "sf": "SF7BW125",
          "radioMode": "LORAWAN_AND_IQ_D2D",
          "numberOfJoinAttempts": 10,
          "linkCheckTimeframe": 1440,
          "dataRetransmission": "ENABLED",
          "lorawanWatchdogAlarm": "NORMAL",
          "joinStatus": "ONLINE",
          "applicationPort": 50,
          "joinType": "OTAA"
        }
      }
    },
    {
      "name": "read response: ADR profile and SF12",
      "fPort": 100,
      "payload": "FFA2 01 FFA1 00",
      "payloadHex": "FFA201FFA100",
      "expected": {
        "data": {
          "adrProfile": "MOBILE_LONG_RANGE",
          "sf": "SF12BW125"
        }
      }
    },
    {
      "name": "read response: radio information",
      "fPort": 100,
      "payload": "FF97 064C5231313130 FF98 01 FF99 010004",
      "payloadHex": "FF97064C5231313130FF9801FF99010004",
      "expected": {
        "data": {
          "radioModule": "LR1110",
          "lorawanRegion": "EU868",
          "lorawanVersion": "v1.0.4"
        }
      }
    },
    {
      "name": "read response: labels and empty string",
      "fPort": 100,
      "payload": "FF32 0A4275696C64696E672041 FF33 07526F6F6D203132 FF34 00",
      "payloadHex": "FF320A4275696C64696E672041FF3307526F6F6D203132FF3400",
      "expected": {
        "data": {
          "buildingName": "Building A",
          "buildingRoom": "Room 12",
          "deviceName": ""
        }
      }
    },
    {
      "name": "read response: sensors and battery",
      "fPort": 100,
      "payload": "FF7A FF38 FF7B 37 FF82 0992 FF83 28 FF78 00 FF79 00000003 FF6B 00 FF6C 24 FF6D 64",
      "payloadHex": "FF7AFF38FF7B37FF820992FF8328FF7800FF7900000003FF6B00FF6C24FF6D64",
      "expected": {
        "data": {
          "internalCircuitTemperature": -2,
          "internalCircuitHumidity": 55,
          "ambientTemperature": 24.5,
          "ambientHumidity": 40,
          "internalCircuitTemperatureAlarm": "NORMAL",
          "internalCircuitTemperatureNumberOfAlarms": 3,
          "externalPowerStatus": "BATTERY_POWER",
          "batteryVoltage": 3.6,
          "batteryPercentage": 100
        }
      }
    },
    {
      "name": "read response: special mode and unknown enum values",
      "fPort": 100,
      "payload": "FF64 01 FF98 0E FF9E 02",
      "payloadHex": "FF6401FF980EFF9E02",
      "expected": {
        "data": {
          "deviceStatus": "SPECIAL_MODE",
          "lorawanRegion": "UNKNOWN (14)",
          "joinType": "UNKNOWN (2)"
        }
      }
    },
    {
      "name": "periodic: generic sensors (fPort 1)",
      "fPort": 1,
      "payload": "FF01 6955B900 FF7A 0929 FF7B 30 FF82 FBE6",
      "payloadHex": "FF016955B900FF7A0929FF7B30FF82FBE6",
      "expected": {
        "data": {
          "dataloggerTimestamp": 1767225600,
          "internalCircuitTemperature": 23.45,
          "internalCircuitHumidity": 48,
          "ambientTemperature": -10.5
        }
      }
    },
    {
      "name": "unknown register stops decoding",
      "fPort": 100,
      "payload": "FF6A 0100 1234 00",
      "payloadHex": "FF6A0100123400",
      "expected": {
        "data": {
          "hardwareVersion": "v1.0",
          "error": "Unknown register 0x1234 at index 4"
        },
        "errors": [
          "Unknown register 0x1234 at index 4"
        ]
      }
    },
    {
      "name": "read response: serial number reads as 8 hexadecimal digits, leading zeros kept",
      "fPort": 100,
      "payload": "FF68 00007563",
      "payloadHex": "FF6800007563",
      "expected": {
        "data": {
          "deviceSerialNumber": "00007563"
        }
      }
    },
    {
      "name": "read response: serial number with the top bit set reads as unsigned hexadecimal",
      "fPort": 100,
      "payload": "FF68 956600E6",
      "payloadHex": "FF68956600E6",
      "expected": {
        "data": {
          "deviceSerialNumber": "956600E6"
        }
      }
    },
    {
      "name": "truncated value is an error",
      "fPort": 100,
      "payload": "FF68 0001",
      "payloadHex": "FF680001",
      "expected": {
        "data": {
          "error": "Payload too short for register 0xFF68 at index 0"
        },
        "errors": [
          "Payload too short for register 0xFF68 at index 0"
        ]
      }
    },
    {
      "name": "truncated string is an error",
      "fPort": 100,
      "payload": "FF34 05 4142",
      "payloadHex": "FF34054142",
      "expected": {
        "data": {
          "error": "Payload too short for register 0xFF34 at index 0"
        },
        "errors": [
          "Payload too short for register 0xFF34 at index 0"
        ]
      }
    },
    {
      "name": "truncated address is an error",
      "fPort": 100,
      "payload": "FF6A 0100 12",
      "payloadHex": "FF6A010012",
      "expected": {
        "data": {
          "hardwareVersion": "v1.0",
          "error": "Incomplete register address at index 4"
        },
        "errors": [
          "Incomplete register address at index 4"
        ]
      }
    },
    {
      "name": "status byte: command succeeded (fPort 50)",
      "fPort": 50,
      "payload": "00",
      "payloadHex": "00",
      "expected": {
        "data": {
          "info": "DOWNLINK COMMAND SUCCEEDED"
        }
      }
    },
    {
      "name": "status byte: command failed (fPort 100)",
      "fPort": 100,
      "payload": "01",
      "payloadHex": "01",
      "expected": {
        "data": {
          "warning": "DOWNLINK COMMAND FAILED"
        },
        "warnings": [
          "DOWNLINK COMMAND FAILED"
        ]
      }
    },
    {
      "name": "status byte: uplink configuration accepted (fPort 3)",
      "fPort": 3,
      "payload": "00",
      "payloadHex": "00",
      "expected": {
        "data": {
          "info": "DOWNLINK COMMAND SUCCEEDED"
        }
      }
    },
    {
      "name": "MAC commands (fPort 0)",
      "fPort": 0,
      "payload": "0302",
      "payloadHex": "0302",
      "expected": {
        "data": {
          "mac": "MAC COMMAND RECEIVED",
          "fPort": 0
        }
      }
    },
    {
      "name": "FUOTA fragment (fPort 201)",
      "fPort": 201,
      "payload": "08 0001 AABBCCDD",
      "payloadHex": "080001AABBCCDD",
      "expected": {
        "data": {
          "info": "FUOTA DATA RECEIVED"
        }
      }
    },
    {
      "name": "FMP: device version (fPort 203)",
      "fPort": 203,
      "payload": "01 03000201 00000001",
      "payloadHex": "010300020100000001",
      "expected": {
        "data": {
          "fmpDevVersionAns": {
            "firmware": {
              "major": 1,
              "minor": 2,
              "revision": 3,
              "version": "v1.2.3"
            },
            "hardware": {
              "major": 1,
              "minor": 0,
              "revision": 0,
              "version": "v1.0.0"
            }
          },
          "info": "FIRMWARE MANAGEMENT DATA RECEIVED"
        }
      }
    },
    {
      "name": "FMP: upgrade image valid (fPort 203)",
      "fPort": 203,
      "payload": "04 03 03000201",
      "payloadHex": "040303000201",
      "expected": {
        "data": {
          "fmpDevUpgradeImageAns": {
            "major": 1,
            "minor": 2,
            "revision": 3,
            "version": "v1.2.3",
            "status": "FIRMWARE_UPGRADE_IMAGE_VALID"
          },
          "info": "FIRMWARE MANAGEMENT DATA RECEIVED"
        }
      }
    },
    {
      "name": "FMP: upgrade image invalid (fPort 203)",
      "fPort": 203,
      "payload": "04 01",
      "payloadHex": "0401",
      "expected": {
        "data": {
          "fmpDevUpgradeImageAns": {
            "status": "FIRMWARE_UPGRADE_IMAGE_INVALID"
          },
          "info": "FIRMWARE MANAGEMENT DATA RECEIVED"
        }
      }
    },
    {
      "name": "unsupported fPort",
      "fPort": 150,
      "payload": "0102",
      "payloadHex": "0102",
      "expected": {
        "data": {
          "fPort": 150,
          "error": "Incorrect fPort"
        },
        "errors": [
          "Incorrect fPort"
        ]
      }
    },
    {
      "name": "periodic: factory uplink with every input (fPort 1)",
      "fPort": 1,
      "payload": "FF01 6955B900 0101 00001403 0201 00000000 0301 FFFFFFFE 0401 0000270F 0501 00003039 0601 00000FA0 0701 00005000 0801 FFFFFFFF",
      "payloadHex": "FF016955B9000101000014030201000000000301FFFFFFFE04010000270F050100003039060100000FA00701000050000801FFFFFFFF",
      "expected": {
        "data": {
          "dataloggerTimestamp": 1767225600,
          "input1Voltage": 5.123,
          "input2Voltage": 0,
          "input3Voltage": -0.002,
          "input4Voltage": 9.999,
          "input1Current": 12.345,
          "input2Current": 4,
          "input3Current": 20.48,
          "input4Current": -0.001
        }
      }
    },
    {
      "name": "read response: raw ADC counts",
      "fPort": 100,
      "payload": "0100 4268 0500 FFFD 0400 7FFF 0800 0000",
      "payloadHex": "010042680500FFFD04007FFF08000000",
      "expected": {
        "data": {
          "input1VoltageRaw": 17000,
          "input1CurrentRaw": -3,
          "input4VoltageRaw": 32767,
          "input4CurrentRaw": 0
        }
      }
    },
    {
      "name": "read response: input switch positions and thresholds",
      "fPort": 100,
      "payload": "0A00 01 0A01 00000032 0A02 00000DAC 0B00 02 0C00 00 0D00 03 0D01 000003E8 0D02 00000000",
      "payloadHex": "0A00010A01000000320A0200000DAC0B00020C00000D00030D01000003E80D0200000000",
      "expected": {
        "data": {
          "input1SwitchPosition": "VOLTAGE",
          "input1VoltageThreshold": 0.05,
          "input1CurrentThreshold": 3.5,
          "input2SwitchPosition": "CURRENT",
          "input3SwitchPosition": "UNKNOWN",
          "input4SwitchPosition": "UNKNOWN (3)",
          "input4VoltageThreshold": 1,
          "input4CurrentThreshold": 0
        }
      }
    },
    {
      "name": "alarm: two input switches changed (fPort 11)",
      "fPort": 11,
      "payload": "FF01 6955B900 0A00 01 0101 00001388 0501 00000000 0B00 02 0201 0000000C 0601 00002EE0",
      "payloadHex": "FF016955B9000A00010101000013880501000000000B000202010000000C060100002EE0",
      "expected": {
        "data": {
          "dataloggerTimestamp": 1767225600,
          "input1SwitchPosition": "VOLTAGE",
          "input1Voltage": 5,
          "input1Current": 0,
          "input2SwitchPosition": "CURRENT",
          "input2Voltage": 0.012,
          "input2Current": 12
        }
      }
    },
    {
      "name": "alarm: device time not synchronized yet, timestamp 0 (fPort 11)",
      "fPort": 11,
      "payload": "FF01 00000000 0D00 00 0401 00000028 0801 00000834",
      "payloadHex": "FF01000000000D0000040100000028080100000834",
      "expected": {
        "data": {
          "dataloggerTimestamp": 0,
          "input4SwitchPosition": "UNKNOWN",
          "input4Voltage": 0.04,
          "input4Current": 2.1
        }
      }
    },
    {
      "name": "register between two channel blocks is unknown",
      "fPort": 1,
      "payload": "FF01 6955B900 0101 00000001 0900 00000001",
      "payloadHex": "FF016955B900010100000001090000000001",
      "expected": {
        "data": {
          "dataloggerTimestamp": 1767225600,
          "input1Voltage": 0.001,
          "error": "Unknown register 0x0900 at index 12"
        },
        "errors": [
          "Unknown register 0x0900 at index 12"
        ]
      }
    },
    {
      "name": "register after the last one of a channel is unknown",
      "fPort": 100,
      "payload": "0102 00000001",
      "payloadHex": "010200000001",
      "expected": {
        "data": {
          "error": "Unknown register 0x0102 at index 0"
        },
        "errors": [
          "Unknown register 0x0102 at index 0"
        ]
      }
    },
    {
      "name": "truncated calculated value is an error",
      "fPort": 1,
      "payload": "FF01 6955B900 0101 0001",
      "payloadHex": "FF016955B90001010001",
      "expected": {
        "data": {
          "dataloggerTimestamp": 1767225600,
          "error": "Payload too short for register 0x0101 at index 6"
        },
        "errors": [
          "Payload too short for register 0x0101 at index 6"
        ]
      }
    },
    {
      "name": "max demand fPort 20 is not used",
      "fPort": 20,
      "payload": "FF01 6955B900 FF7A 0064",
      "payloadHex": "FF016955B900FF7A0064",
      "expected": {
        "data": {
          "fPort": 20,
          "error": "Incorrect fPort"
        },
        "errors": [
          "Incorrect fPort"
        ]
      }
    }
  ],
  "downlinks": [
    {
      "name": "config: restart LoRaWAN",
      "input": {
        "fPort": 50,
        "Type": "Config",
        "Config": [
          {
            "Param": "restartLoRaWAN",
